# Optional settings. Every value has a working default, so
# `docker compose up --build` runs without a .env file.

# Set to false to skip the transformer models (rule-based fallback only).
AI_ENABLED=true
# Set to false to skip the mDeBERTa NLI model (saves ~1 GB RAM; less accurate).
NLI_ENABLED=true

# Optional small LLM for the Investigator and Critic agents. Leave empty to
# run without it (recommended on laptops). To use it:
#   Mac / Windows with the Ollama app installed:  OLLAMA_URL=http://host.docker.internal:11434
#   Ollama in Docker (docker compose --profile llm up --build):  OLLAMA_URL=http://ollama:11434
OLLAMA_URL=
LLM_MODEL=qwen2.5:1.5b

POSTGRES_USER=anvaya
POSTGRES_PASSWORD=anvaya
POSTGRES_DB=anvaya

FRONTEND_PORT=5173
BACKEND_PORT=8000
